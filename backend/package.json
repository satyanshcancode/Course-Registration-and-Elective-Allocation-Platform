{
  "name": "@course-reg/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express + PostgreSQL API for course registration and elective allocation",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/database/migrations','dist/database/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "migrate": "tsx --conditions=source src/database/migrate.ts",
    "migrate:prod": "node dist/database/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --conditions=source src/database/seeds/seed.ts",
    "seed:demo-submissions": "tsx --conditions=source src/database/seeds/seedDemoSubmissions.ts",
    "seed:prod": "node dist/database/seeds/seed.js",
    "seed:demo-submissions:prod": "node dist/database/seeds/seedDemoSubmissions.js",
    "demo:concurrent-submit": "tsx --conditions=source src/scripts/demoConcurrentSubmit.ts"
  },
  "dependencies": {
    "@course-reg/shared": "0.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
