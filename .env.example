# Copy to .env and adjust. Never commit .env.
# Used by docker compose (variable substitution) and by the backend/frontend
# when they run directly on the host (`npm run dev`).

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=course_reg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=course_registration

# --- Backend ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Host-run connection string. Inside Docker Compose this is overridden to use
# the `postgres` service hostname.
DATABASE_URL=postgres://course_reg:change-me@localhost:5432/course_registration
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
# Integration tests use DATABASE_URL with "_test" appended to the database name
# (created automatically by the postgres container). Override if needed:
# TEST_DATABASE_URL=postgres://course_reg:change-me@localhost:5432/course_registration_test
JSON_BODY_LIMIT=100kb
# CSV imports are far larger than any other request body.
CSV_BODY_LIMIT=2mb
# debug | info | warn | error | silent
LOG_LEVEL=info
# Signs session tokens (HS256). At least 32 characters; production refuses this
# example value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# Secure cookie flag: defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# --- E-mail -------------------------------------------------------------------
# Where students open the app. Activation and password-reset links are built
# from it, so it must be the browser's address (8080 for the production stack).
APP_BASE_URL=http://localhost:5173
# Docker Compose overrides SMTP_HOST to the `mailpit` service and reads every
# message at http://localhost:8025. Left unset when running on the host, account
# e-mails are written to the backend log instead of sent; NODE_ENV=production
# refuses to start without it.
# SMTP_HOST=localhost
SMTP_PORT=1025
# true only for implicit TLS (port 465); port 587 upgrades with STARTTLS.
SMTP_SECURE=false
# Set both or neither. Mailpit needs no credentials.
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=Course Registration <no-reply@university.edu>

# --- Frontend (Vite dev server) -----------------------------------------------
# Where Vite proxies /api. Inside Docker Compose this is http://backend:4000.
API_PROXY_TARGET=http://localhost:4000
