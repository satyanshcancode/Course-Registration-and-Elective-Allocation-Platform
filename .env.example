# Copy to .env and adjust. Never commit .env.
# Used by docker compose (variable substitution) and by the backend/frontend
# when they run directly on the host (`npm run dev`).

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=course_reg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=course_registration

# --- Backend ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Host-run connection string. Inside Docker Compose this is overridden to use
# the `postgres` service hostname.
DATABASE_URL=postgres://course_reg:change-me@localhost:5432/course_registration
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
# Integration tests use DATABASE_URL with "_test" appended to the database name
# (created automatically by the postgres container). Override if needed:
# TEST_DATABASE_URL=postgres://course_reg:change-me@localhost:5432/course_registration_test
JSON_BODY_LIMIT=100kb
# CSV imports are far larger than any other request body.
CSV_BODY_LIMIT=2mb
# debug | info | warn | error | silent
LOG_LEVEL=info
# Signs session tokens (HS256). At least 32 characters; production refuses this
# example value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# Secure cookie flag: defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# --- E-mail -------------------------------------------------------------------
# Where students open the app. Activation and password-reset links are built
# from it, so it must be the browser's address. LEAVE IT UNSET for the Compose
# stacks: each defaults it correctly on its own (5173 for dev, 8080 for prod,
# where it is also the CORS origin). Setting it here would pin BOTH to one
# address, and the production stack would then refuse its own front end.
# Set it only when deploying somewhere else.
# APP_BASE_URL=https://registration.university.edu
# Every mail setting below is optional. LEAVE THEM ALL COMMENTED OUT and the
# Docker stack sends to the `mailpit` service, where every message can be read
# at http://localhost:8025 without reaching a real inbox — which is what the
# tests and the demo expect. Running on the host with no SMTP_HOST at all,
# account e-mails are written to the backend log instead; NODE_ENV=production
# refuses to start without one.
#
# Uncomment and fill these in to send for real. NEVER COMMIT A REAL KEY: this
# file is the example, and .env is gitignored.
#
# Brevo (smtp-relay.brevo.com) is STARTTLS on 587, so SMTP_SECURE stays false —
# set it to true only for implicit TLS on 465. Whenever a user and password are
# set, the backend REQUIRES the connection to be encrypted before sending them,
# so a relay that stopped offering STARTTLS fails the send rather than leaking
# the credential.
#
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# Set both or neither. Your Brevo SMTP login and the key generated for it.
# SMTP_USER=<YOUR_BREVO_LOGIN>
# SMTP_PASSWORD=<YOUR_SMTP_KEY>
#
# The sender. A relay only accepts an address it has verified as a sender, so
# this must be one Brevo knows. MAIL_FROM may also hold a whole header
# ("Allocademy <no-reply@university.edu>"), in which case
# MAIL_FROM_NAME is ignored.
# MAIL_FROM=no-reply@university.edu
# MAIL_FROM_NAME=Allocademy

# --- Frontend (Vite dev server) -----------------------------------------------
# Where Vite proxies /api. Inside Docker Compose this is http://backend:4000.
API_PROXY_TARGET=http://localhost:4000
